# このファイルを .env にコピーして値を変更してください。
# .env はコミットしないこと(.gitignoreで除外済み)。

MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=event-planner
MYSQL_USER=appuser
MYSQL_PASSWORD=change_me_app_password

# フロントエンドのオリジン(CORS許可用、カンマ区切り)
APP_CORS_ALLOWED_ORIGINS=http://localhost:8081

# JWT署名鍵(ログイントークンの発行・検証に使用)。
# ★ 本番運用では必ず長いランダム文字列に変更すること(例: openssl rand -base64 48)。
# 未設定のまま起動した場合、アプリ再起動のたびに発行済みトークンが全て失効するので開発時も設定推奨。
JWT_SECRET=change_me_to_a_long_random_string
